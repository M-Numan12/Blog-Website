PORT=5000
NODE_ENV=production
# Use MongoDB Atlas connection string on Hostinger Business/Cloud Hosting
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/celebscope?retryWrites=true&w=majority
JWT_SECRET=replace_with_a_64_char_random_secret
JWT_EXPIRES_IN=7d
# Comma-separated allowed frontend URLs
CLIENT_URL=https://yourdomain.com,https://www.yourdomain.com
# Use "none" when frontend (yourdomain.com) and API (api.yourdomain.com) are on different subdomains over HTTPS
COOKIE_SAME_SITE=none
# Optional: set to .yourdomain.com to share auth cookie across subdomains
COOKIE_DOMAIN=
